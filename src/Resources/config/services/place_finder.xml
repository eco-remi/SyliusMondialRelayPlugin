<?xml version="1.0" encoding="UTF-8" ?>

<container xmlns="http://symfony.com/schema/dic/services" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>
        <service id="eResponsable.sylius_mondial_relay_plugin.place_finder.registry" class="EResponsable\SyliusMondialRelayPlugin\PlaceFinder\PlaceFinderRegistry">
            <argument type="tagged_iterator" tag="eResponsable.sylius_mondial_relay_plugin.place_finder" />
        </service>
        <service id="eResponsable.sylius_mondial_relay_plugin.place_finder.google" class="EResponsable\SyliusMondialRelayPlugin\PlaceFinder\GooglePlaceFinder">
            <argument>%eResponsable_sylius_mondial_relay.google_api_key%</argument>
            <tag name="eResponsable.sylius_mondial_relay_plugin.place_finder" />
        </service>
        <service id="eResponsable.sylius_mondial_relay_plugin.place_finder.nominatim" class="EResponsable\SyliusMondialRelayPlugin\PlaceFinder\NominatimPlaceFinder">
            <tag name="eResponsable.sylius_mondial_relay_plugin.place_finder" />
        </service>
    </services>
</container>

{% set method = hookable_metadata.context.method %}
{% set choice_form = hookable_metadata.context.form %}

{# Détection de la méthode Mondial Relay #}
{% if method.calculator == 'mondial_relay' or (choice_form.vars.attr['data-mr'] is defined and choice_form.vars.attr['data-mr'] == 'true') %}
    {% set shipment_form = choice_form.parent.parent %}

    {# Rendu impératif du champ caché pickupPointId #}
    {% if shipment_form.pickupPointId is defined and not shipment_form.pickupPointId.rendered %}
        {{ form_widget(shipment_form.pickupPointId) }}
    {% endif %}

    <div id="current-pickup-point" class="mr-current-pickup-point-card mt-2" style="display: none;">
        <button data-load-pickup-point-list type="button" class="btn btn-outline-primary btn-sm">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-geo-alt-fill me-1" viewBox="0 0 16 16">
                <path d="M8 16s6-5.686 6-10A6 6 0 0 0 2 6c0 4.314 6 10 6 10m0-7a3 3 0 1 1 0-6 3 3 0 0 1 0 6"/>
            </svg>
            {{ 'sylius.mondial_relay.select_a_relay_point'|trans }}
        </button>
    </div>
{% endif %}

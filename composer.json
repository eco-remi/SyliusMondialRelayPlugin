{
    "name": "eresponsable/sylius-mondial-relay-plugin",
    "type": "sylius-plugin",
    "description": "Sylius plugin for Mondial Relay.",
    "keywords": [
        "sylius",
        "sylius-plugin",
        "mondial-relay"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "ext-curl": "*",
        "ext-soap": "*",
        "sylius/sylius": "^2.0",
        "sylius/ui-bundle": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "autoload": {
        "psr-4": {
            "EResponsable\\SyliusMondialRelayPlugin\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "EResponsable\\SyliusMondialRelayPlugin\\Tests\\": "tests/"
        }
    }
}

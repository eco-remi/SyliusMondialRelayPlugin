{
    "name": "eresponsable/sylius-mondial-relay-plugin",
    "type": "sylius-plugin",
    "description": "Sylius plugin for Mondial Relay (Sylius 2.x & Bootstrap 5 compatible).",
    "version": "1.2.0",
    "keywords": [
        "sylius",
        "sylius-plugin",
        "mondial-relay"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2 || ^8.3 || ^8.4 || ^8.5",
        "ext-curl": "*",
        "ext-soap": "*",
        "sylius/sylius": "^2.0",
        "symfony/config": "^6.4 || ^7.0",
        "symfony/dependency-injection": "^6.4 || ^7.0",
        "symfony/form": "^6.4 || ^7.0",
        "symfony/http-foundation": "^6.4 || ^7.0",
        "symfony/routing": "^6.4 || ^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "autoload": {
        "psr-4": {
            "EResponsable\\SyliusMondialRelayPlugin\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "EResponsable\\SyliusMondialRelayPlugin\\Tests\\": "tests/"
        }
    }
}
